# Copy this file to .env, then replace each @... value with your own setting.
# Never commit .env or share API keys, bot tokens, chat IDs, or SSH keys.
YOUTUBE_API_URL=@YOUTUBE_API
TELEGRAM_API_URL=@TELEGRAM_API
YOUTUBE_API_KEY=@YOUTUBE_API_KEY
TELEGRAM_BOT_TOKEN=@TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_IDS=@CHAT_ID,@SECOND_CHAT_ID

# Main auto-discovery monitor settings
YOUTUBE_CHANNEL_HANDLE=@CHANNEL_HANDLE
YOUTUBE_VIDEO_URL_TEMPLATE=@VIDEO_URL
TARGET_USERNAMES=@TARGET_USERNAME,@SECOND_TARGET_USERNAME
DISCOVERY_INTERVAL_SECONDS=1200

# Optional legacy manual-URL diagnostic settings
YOUTUBE_VIDEO_URL=@VIDEO_URL
TARGET_USERNAME=@TARGET_USERNAME
TELEGRAM_CHAT_ID=@CHAT_ID